[Unit]
Description=Axon OS Semantic Search Service
After=dbus.socket axon-brain.service
Requires=dbus.socket

[Service]
Type=dbus
BusName=org.axonos.Search
ExecStart=/usr/bin/python3 AXON_SERVICES_DIR/axon-search/search_service.py
Restart=on-failure
RestartSec=3
Nice=10
IOSchedulingClass=idle
# Only NoNewPrivileges: PrivateTmp/Protect* need user namespaces in a user
# manager, which Ubuntu 24.04 restricts, so they fail with 218/CAPABILITIES.
NoNewPrivileges=true

[Install]
WantedBy=default.target
