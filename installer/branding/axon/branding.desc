# Calamares branding descriptor — Axon OS
# https://github.com/calamares/calamares/blob/calamares/src/branding/default/branding.desc

---

componentName: axon

# -----------------------------------------------------------------------
# Strings displayed in the installer UI
# -----------------------------------------------------------------------
strings:
    productName:         "Axon OS"
    shortProductName:    "Axon"
    version:             "0.3.0"
    shortVersion:        "0.3"
    versionedName:       "Axon OS 0.3.0"
    shortVersionedName:  "Axon 0.3"
    bootloaderEntryName: "Axon OS"
    productUrl:          "https://github.com/kaorii-ako/Axon-OS"
    supportUrl:          "https://github.com/kaorii-ako/Axon-OS/issues"
    knownIssuesUrl:      "https://github.com/kaorii-ako/Axon-OS/issues"
    releaseNotesUrl:     "https://github.com/kaorii-ako/Axon-OS/releases"

# -----------------------------------------------------------------------
# Images — paths are relative to this branding directory
# -----------------------------------------------------------------------
images:
    productLogo:    "logo.png"
    productIcon:    "icon.png"
    productWelcome: "welcome.png"

# -----------------------------------------------------------------------
# Slideshow shown during installation
# -----------------------------------------------------------------------
slideshow: "AxonSlideshow.qml"

# Slideshow API version (1 = simple, 2 = with signals).
slideshowAPI: 2

# -----------------------------------------------------------------------
# Style / colors
# -----------------------------------------------------------------------
style:
    # Sidebar background
    sidebarBackground:  "#161616"
    # Sidebar text
    sidebarText:        "#f2f2f2"
    # Sidebar menu highlight background
    sidebarTextSelect:  "#2b6fde"
    # Sidebar menu selected text
    sidebarTextHighlight: "#ffffff"

    # Main window background
    windowBackground:   "#1e1e1e"

    # Accent / highlight color (the Axon blue)
    highlightColor:     "#2b6fde"

    # Fonts
    fontFamily:         "Inter"
    bodyFontSize:       "10"
