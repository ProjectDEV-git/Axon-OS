[Unit]
Description=Axon OS Sandbox Manager Service
After=dbus.socket
Requires=dbus.socket

[Service]
Type=dbus
BusName=org.axonos.Sandbox
ExecStart=/usr/bin/python3 AXON_SERVICES_DIR/axon-sandbox/sandbox_manager.py
Restart=on-failure
RestartSec=3
# Only NoNewPrivileges: PrivateTmp/Protect* need user namespaces in a user
# manager, which Ubuntu 24.04 restricts, so they fail with 218/CAPABILITIES.
NoNewPrivileges=true

[Install]
WantedBy=default.target
