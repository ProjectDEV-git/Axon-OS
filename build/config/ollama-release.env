# Pinned Ollama release installed by build/config/install-ollama.sh.
#
# OLLAMA_SHA256 must be the SHA-256 of OLLAMA_ASSET for OLLAMA_VERSION.
# install-ollama.sh refuses to install anything while it is empty. Update all
# three together with:  bash scripts/pin-ollama.sh <version>
OLLAMA_VERSION="v0.35.1"
OLLAMA_ASSET="ollama-linux-amd64.tar.zst"
OLLAMA_SHA256="9fcd79ac4575b2bd31b992eee18b1000c8ad126b451627c8f8cd091714cfbb10"
