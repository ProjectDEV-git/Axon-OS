#!/bin/sh
# Axon OS — keep the release kernel as a fallback for a newer kernel.
# Installed as /etc/grub.d/41_axon_kernel_fallback.
#
# On Ubuntu 24.04 the release kernel is 6.8 and the gaming kernel (Ubuntu's HWE kernel,
# installed from Game Center) is newer; after an upgrade to 26.04 the 6.8 kernel is still
# installed next to the 7.0 one until it is cleaned up. GRUB boots the newest kernel first.
# If it does not boot, the boot watchdog (06_axon_watchdog) sets axon_try_ga on the second
# attempt, and this entry, which boots the oldest installed kernel series on the same
# system, is chosen. A third failed boot still goes to the factory rollback
# (42_axon_rollback).
#
# Emits nothing unless kernels of two different series (6.8 and 6.14, say) are installed,
# and never fails: a problem here must not stop grub.cfg from being written.
BOOT_DIR="${AXON_BOOT_DIR:-/boot}"

# shellcheck disable=SC2012  # kernel file names are plain
kernels="$(ls -1 "${BOOT_DIR}"/vmlinuz-*-generic 2>/dev/null | sort -V)"
[ -n "${kernels}" ] || exit 0
# "vmlinuz-6.8.0-100-generic" -> "6.8"
series_of() { basename "$1" | sed -n 's/^vmlinuz-\([0-9][0-9]*\.[0-9][0-9]*\)\..*/\1/p'; }
newest="$(printf '%s\n' "${kernels}" | tail -n 1)"
oldest_series="$(series_of "$(printf '%s\n' "${kernels}" | head -n 1)")"
[ -n "${oldest_series}" ] && [ "${oldest_series}" != "$(series_of "${newest}")" ] || exit 0
ga="$(printf '%s\n' "${kernels}" | grep "/vmlinuz-${oldest_series}\." | tail -n 1)"
[ -n "${ga}" ] || exit 0

ver="$(basename "${ga}")"
ver="${ver#vmlinuz-}"
initrd="${BOOT_DIR}/initrd.img-${ver}"
[ -f "${initrd}" ] || exit 0

boot_uuid="$(grub-probe --target=fs_uuid "${BOOT_DIR}" 2>/dev/null)" || exit 0
root_uuid="$(grub-probe --target=fs_uuid / 2>/dev/null)" || exit 0
fs="$(grub-probe --target=fs "${BOOT_DIR}" 2>/dev/null)" || exit 0
boot_rel="$(grub-mkrelpath "${BOOT_DIR}" 2>/dev/null)" || exit 0
[ -n "${boot_uuid}" ] && [ -n "${root_uuid}" ] && [ -n "${boot_rel}" ] || exit 0

# Same btrfs sub-volume as the newest kernel's entry (Ubuntu's 10_linux adds the same option)
rootflags=""
if [ "$(grub-probe --target=fs / 2>/dev/null)" = "btrfs" ]; then
    subvol="$(grub-mkrelpath / 2>/dev/null)" || subvol=""
    [ -n "${subvol}" ] && [ "${subvol}" != "/" ] && rootflags="rootflags=subvol=${subvol#/}"
fi

case "${fs}" in
    btrfs) fsmod="btrfs" ;;
    xfs) fsmod="xfs" ;;
    *) fsmod="ext2" ;;
esac

# GRUB_CMDLINE_LINUX* come from /etc/default/grub through grub-mkconfig
cmdline="${GRUB_CMDLINE_LINUX} ${GRUB_CMDLINE_LINUX_DEFAULT}"

cat <<ENTRY
menuentry 'Axon OS — previous kernel (${ver})' --class axon --class gnu-linux --id axon-ga-kernel {
    insmod part_gpt
    insmod ${fsmod}
    search --no-floppy --fs-uuid --set=root ${boot_uuid}
    linux ${boot_rel}/vmlinuz-${ver} root=UUID=${root_uuid} ro ${rootflags} ${cmdline}
    initrd ${boot_rel}/initrd.img-${ver}
}
# Second boot attempt in a row (set by 06_axon_watchdog): try the previous kernel
if [ "\${axon_try_ga}" = "1" ]; then
    set default='axon-ga-kernel'
    set timeout_style=menu
    set timeout=3
fi
ENTRY
