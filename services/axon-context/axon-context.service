[Unit]
Description=Axon OS AI Context Service
After=dbus.socket
Requires=dbus.socket

[Service]
Type=dbus
BusName=org.axonos.Context
ExecStart=/usr/bin/python3 AXON_SERVICES_DIR/axon-context/context_service.py
Restart=on-failure
RestartSec=3
# Only NoNewPrivileges: PrivateTmp/Protect* need user namespaces in a user
# manager, which Ubuntu 24.04 restricts, so they fail with 218/CAPABILITIES.
NoNewPrivileges=true

[Install]
WantedBy=default.target
