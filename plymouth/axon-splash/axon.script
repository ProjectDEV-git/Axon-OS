// Axon OS Plymouth Boot Splash
// Dark background: #0e0e10 (matches the axon.png logo background)

Window.SetBackgroundTopColor(0.055, 0.055, 0.063);
Window.SetBackgroundBottomColor(0.055, 0.055, 0.063);

// --- Logo ---
logo_image = Image("axon.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2);
logo_sprite.SetOpacity(0);

// --- Progress bar ---
// Plymouth's script API has no rectangle primitive: scale 1x1 PNGs instead.
bar_height    = 4;
bar_y         = Window.GetHeight() - 48;
bar_width_max = Math.Int(Window.GetWidth() * 0.5);
bar_x         = Math.Int((Window.GetWidth() - bar_width_max) / 2);

// Background track (#1e1e23)
bar_bg_image = Image("progress-track.png").Scale(bar_width_max, bar_height);
bar_bg_sprite = Sprite(bar_bg_image);
bar_bg_sprite.SetX(bar_x);
bar_bg_sprite.SetY(bar_y);
bar_bg_sprite.SetOpacity(0);

// Fill (violet #a78bfa)
bar_fill_source = Image("progress-fill.png");
bar_fill_sprite = Sprite(bar_fill_source.Scale(1, bar_height));
bar_fill_sprite.SetX(bar_x);
bar_fill_sprite.SetY(bar_y);
bar_fill_sprite.SetOpacity(0);

// --- State ---
progress      = 0.0;
fade_opacity  = 0.0;
fade_done     = 0;
fill_width_shown = 1;

// --- Callbacks ---
fun refresh_callback() {
    // Fade-in: increase opacity by 0.05 per tick until fully visible
    if (fade_done == 0) {
        fade_opacity = fade_opacity + 0.05;
        if (fade_opacity >= 1.0) {
            fade_opacity = 1.0;
            fade_done = 1;
        }
        logo_sprite.SetOpacity(fade_opacity);
        bar_bg_sprite.SetOpacity(fade_opacity);
        bar_fill_sprite.SetOpacity(fade_opacity);
    }

    // Resize the fill only when its width changes (refresh runs ~50x/s)
    fill_width = Math.Int(bar_width_max * progress);
    if (fill_width < 1) {
        fill_width = 1;
    }
    if (fill_width != fill_width_shown) {
        bar_fill_sprite.SetImage(bar_fill_source.Scale(fill_width, bar_height));
        fill_width_shown = fill_width;
    }
}

fun boot_progress_callback(duration, progress_value) {
    progress = progress_value;
}

fun quit_callback() {
    logo_sprite.SetOpacity(0);
    bar_bg_sprite.SetOpacity(0);
    bar_fill_sprite.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(boot_progress_callback);
Plymouth.SetQuitFunction(quit_callback);
