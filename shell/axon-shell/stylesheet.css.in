/* Axon OS GNOME Shell extension stylesheet (template).
 *
 * Edit this file, not stylesheet*.css: scripts/gen_tokens.py fills the
 * {{...}} placeholders from theme/tokens/axon-tokens.json and writes the
 * dark and light stylesheets. Calm and native: neutral surfaces, one
 * translucent material for the floating taskbar (solid with Reduce
 * Transparency or High Contrast), shadows only on what floats, tighter
 * tracking on large type, and the accent only for focus, selection and AI. */

/* ── Shared ─────────────────────────────────────────────────────────────── */

.axon-hint-label {
    color: {{color.fg_muted}};
    font-size: {{font_size.xs}};
    font-family: {{font.family}};
}

.axon-hint-bar {
    margin-top: {{space.md}};
}

.axon-separator {
    background-color: {{color.border}};
    height: 1px;
    margin: {{space.xxs}} 0;
}

.axon-chips-row {
    spacing: {{space.md}};
    margin: {{space.xs}} 0 {{space.md}} 0;
}

.axon-chip {
    border-radius: {{radius.pill}};
    background-color: {{color.hover}};
    border: 1px solid {{color.border}};
    color: {{color.fg_secondary}};
    padding: {{space.xs}} {{space.lg}};
    font-size: {{font_size.sm}};
    font-family: {{font.family}};
    transition-duration: {{duration.fast}};
}

.axon-chip:hover {
    background-color: {{color.active}};
    color: {{color.fg}};
}

.axon-chip:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

/* Status shown with an icon or word as well as colour */
.axon-status-ok { color: {{color.success}}; }
.axon-status-warn { color: {{color.warning}}; }
.axon-status-error { color: {{color.error}}; }

/* ── Intent Bar ─────────────────────────────────────────────────────────── */

.axon-intentbar {
    background-color: {{color.popup}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.lg}};
    box-shadow: {{shadow}};
    padding: {{space.xl}} {{space.xxl}} {{space.lg}} {{space.xxl}};
}

.axon-intentbar-input,
.axon-intentbar-input StEntry {
    background-color: transparent;
    color: {{color.fg}};
    font-size: {{font_size.xl}};
    letter-spacing: {{letter_spacing.title}};
    font-family: {{font.family}};
    border: none;
    border-radius: 0;
    box-shadow: none;
    caret-color: {{color.accent_text}};
    padding: {{space.xs}} 0;
    selection-background-color: {{color.accent_subtle}};
}

.axon-intentbar-input:focus,
.axon-intentbar-input StEntry:focus {
    border: none;
    box-shadow: none;
    background-color: transparent;
}

/* Where the model runs: AI-related, so it may use the accent */
.axon-origin-label {
    color: {{color.accent_text}};
    font-size: {{font_size.xs}};
    font-family: {{font.family}};
    margin-bottom: {{space.md}};
}

.axon-intentbar-stop {
    color: {{color.fg_secondary}};
    border-radius: {{radius.md}};
    padding: {{space.sm}};
}

.axon-intentbar-stop:hover {
    color: {{color.fg}};
    background-color: {{color.hover}};
}

.axon-intentbar-stop:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

.axon-suggestions {
    margin-top: {{space.md}};
    spacing: {{space.xxs}};
}

.axon-suggestion {
    border-radius: {{radius.sm}};
    padding: {{space.sm}} {{space.md}};
    color: {{color.fg}};
    font-family: {{font.family}};
    font-size: {{font_size.md}};
    text-align: left;
}

.axon-suggestion:hover {
    background-color: {{color.hover}};
}

.axon-suggestion:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

/* Selected row: background plus a border, not colour alone */
.axon-suggestion-selected {
    background-color: {{color.accent_subtle}};
    border: 1px solid {{color.focus_ring}};
}

.axon-suggestion-title {
    color: {{color.fg}};
}

.axon-intentbar-empty {
    margin-top: {{space.md}};
}

.axon-response {
    color: {{color.fg}};
    font-size: {{font_size.md}};
    font-family: {{font.family}};
}

.axon-response-scroll {
    border-top: 1px solid {{color.border}};
    margin-top: {{space.lg}};
    padding-top: {{space.lg}};
    max-height: 320px;
}

.axon-response-error,
.axon-response-error-icon {
    color: {{color.error}};
}

.axon-response-error-icon {
    margin-right: {{space.md}};
}

/* ── Taskbar ────────────────────────────────────────────────────────────── */

/* The chrome frame on the screen edge; the bar floats inside it */
.axon-taskbar-frame {
    background-color: transparent;
}

.axon-taskbar {
    background-color: {{color.material}};
    border: 1px solid {{color.border}};
    border-top-color: {{color.material_edge}};
    border-radius: {{radius.lg}};
    box-shadow: {{shadow}};
    padding: 0 {{space.md}};
    spacing: 0;
}

/* Reduce Transparency / High Contrast: a solid, clearly edged surface */
.axon-taskbar-solid {
    background-color: {{color.surface}};
    border: 1px solid {{color.border_strong}};
}

.axon-taskbar-left {
    spacing: {{space.md}};
}

.axon-taskbar-right {
    spacing: {{space.lg}};
    padding-right: {{space.md}};
}

.axon-taskbar-center-apps {
    spacing: {{space.xs}};
}

.axon-dock-icon {
    border-radius: {{radius.md}};
    padding: {{space.xs}};
    width: 40px;
    height: 40px;
    transition-duration: {{duration.fast}};
    background-color: transparent;
    border: 1px solid transparent;
    margin: {{space.xs}} 0;
}

.axon-dock-icon:hover {
    background-color: {{color.hover}};
}

.axon-dock-icon:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

.axon-taskbar-icon-svg {
    color: {{color.fg_secondary}};
}

/* Running-app marker: a small neutral dot (status, not decoration) */
.axon-dock-dot {
    background-color: {{color.fg_secondary}};
    border-radius: {{radius.pill}};
    width: 4px;
    height: 4px;
    margin: {{space.xxs}} auto 0 auto;
}

.axon-dock-separator {
    background-color: {{color.border}};
    width: 1px;
    height: 24px;
    margin: 0 {{space.md}};
}

/* GNOME's own date menu and Quick Settings, adopted into the taskbar. Their
 * usual styles hang off #panel, which they are no longer inside. */
.axon-taskbar .panel-button {
    color: {{color.fg}};
    font-family: {{font.family}};
    font-size: {{font_size.sm}};
    font-weight: {{font_weight.medium}};
    border-radius: {{radius.md}};
    padding: 0 {{space.md}};
    margin: {{space.sm}} 0;
    background-color: transparent;
    transition-duration: {{duration.fast}};
}

.axon-taskbar .panel-button:hover {
    background-color: {{color.hover}};
}

.axon-taskbar .panel-button:active,
.axon-taskbar .panel-button:checked {
    background-color: {{color.active}};
}

.axon-taskbar .panel-button:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

.axon-taskbar .system-status-icon {
    icon-size: 16px;
    padding: 0 1px;
}

.axon-taskbar .panel-status-indicators-box {
    spacing: {{space.xs}};
}

.axon-dock-tooltip {
    background-color: {{color.surface_raised}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    box-shadow: {{shadow}};
    color: {{color.fg}};
    font-size: {{font_size.xs}};
    font-family: {{font.family}};
    font-weight: {{font_weight.medium}};
    padding: {{space.xs}} {{space.md}};
}

.axon-taskbar-showdesktop {
    width: 8px;
    height: 32px;
    margin-left: {{space.sm}};
    border-radius: {{radius.sm}};
    background-color: transparent;
    border-left: 1px solid {{color.border}};
}

.axon-taskbar-showdesktop:hover {
    background-color: {{color.hover}};
}

/* AI status in the taskbar: a word and a dot, never colour alone */
.axon-ai-indicator {
    margin: 0 {{space.md}};
    spacing: {{space.xs}};
}

.axon-ai-indicator-icon {
    color: {{color.accent_text}};
    font-family: {{font.family}};
    font-size: {{font_size.sm}};
    font-weight: {{font_weight.semibold}};
}

.axon-ai-indicator-dot {
    font-size: 7.5pt;
}

/* ── Start Menu (size is set from JS to fit the work area) ──────────────── */

.axon-startmenu {
    background-color: {{color.popup}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.lg}};
    box-shadow: {{shadow}};
    padding: {{space.xxl}};
}

.axon-startmenu-search-container {
    margin-bottom: {{space.xl}};
    background-color: {{color.surface}};
    border: 1px solid {{color.border}};
    border-radius: {{radius.md}};
    padding: {{space.sm}} {{space.lg}};
}

.axon-startmenu-search-container:focus,
.axon-startmenu-search:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

.axon-startmenu-search,
.axon-startmenu-search StEntry {
    background-color: transparent;
    border: none;
    box-shadow: none;
    color: {{color.fg}};
    font-size: {{font_size.lg}};
    font-family: {{font.family}};
}

.axon-startmenu-content {
    spacing: {{space.xxl}};
    margin-bottom: {{space.xl}};
}

.axon-startmenu-section-title {
    color: {{color.fg_secondary}};
    font-size: {{font_size.sm}};
    font-weight: {{font_weight.semibold}};
    margin-bottom: {{space.lg}};
    font-family: {{font.family}};
}

.axon-startmenu-apps-column,
.axon-startmenu-files-column {
    spacing: {{space.md}};
}

.axon-startmenu-apps-grid {
    spacing: {{space.lg}};
}

.axon-startmenu-app-item {
    border-radius: {{radius.md}};
    padding: {{space.lg}} {{space.md}};
    width: 90px;
    background-color: transparent;
    border: 1px solid transparent;
}

.axon-startmenu-app-item:hover {
    background-color: {{color.hover}};
}

.axon-startmenu-app-item:focus,
.axon-startmenu-file-item:focus,
.axon-startmenu-power-btn:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

.axon-startmenu-app-label {
    color: {{color.fg}};
    font-size: {{font_size.xs}};
    margin-top: {{space.sm}};
    text-align: center;
    font-family: {{font.family}};
}

.axon-startmenu-files-column {
    border-left: 1px solid {{color.border}};
    padding-left: {{space.xl}};
}

.axon-startmenu-files-list {
    spacing: {{space.sm}};
}

.axon-startmenu-file-item {
    border-radius: {{radius.sm}};
    padding: {{space.md}} {{space.lg}};
    background-color: transparent;
    border: 1px solid transparent;
    text-align: left;
}

.axon-startmenu-file-item:hover {
    background-color: {{color.hover}};
}

.axon-startmenu-file-label {
    color: {{color.fg}};
    font-size: {{font_size.sm}};
    font-family: {{font.family}};
}

.axon-startmenu-file-icon {
    color: {{color.fg_secondary}};
}

.axon-startmenu-no-files {
    color: {{color.fg_muted}};
    font-size: {{font_size.sm}};
    padding: {{space.md}};
    font-family: {{font.family}};
}

.axon-startmenu-footer {
    border-top: 1px solid {{color.border}};
    padding-top: {{space.xl}};
    spacing: {{space.lg}};
}

.axon-startmenu-user {
    spacing: {{space.md}};
}

.axon-startmenu-avatar {
    color: {{color.fg_secondary}};
}

.axon-startmenu-username {
    color: {{color.fg}};
    font-size: {{font_size.md}};
    font-weight: {{font_weight.semibold}};
    font-family: {{font.family}};
}

.axon-startmenu-power-box {
    spacing: {{space.md}};
}

.axon-startmenu-power-btn {
    background-color: transparent;
    border: 1px solid {{color.border}};
    border-radius: {{radius.sm}};
    padding: {{space.md}};
    color: {{color.fg_secondary}};
}

.axon-startmenu-power-btn:hover {
    background-color: {{color.hover}};
    color: {{color.fg}};
}

/* ── Space OSD ──────────────────────────────────────────────────────────── */

.axon-space-osd {
    background-color: {{color.popup}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.lg}};
    box-shadow: {{shadow}};
    padding: {{space.xl}} {{space.xxl}};
    min-width: 200px;
}

.axon-space-osd-number {
    font-size: {{font_size.display}};
    font-family: {{font.family}};
    font-weight: {{font_weight.bold}};
    letter-spacing: {{letter_spacing.display}};
}

/* The Space's own colour (user data, set from JS) as a swatch, not as text */
.axon-space-osd-swatch {
    width: 24px;
    height: 4px;
    border-radius: {{radius.pill}};
    margin-top: {{space.xs}};
}

.axon-space-osd-name {
    font-size: {{font_size.xl}};
    font-family: {{font.family}};
    font-weight: {{font_weight.semibold}};
    color: {{color.fg}};
    margin-top: {{space.xs}};
}

.axon-space-osd-index {
    font-size: {{font_size.sm}};
    font-family: {{font.family}};
    color: {{color.fg_secondary}};
    margin-top: {{space.sm}};
}

.axon-space-osd-summary {
    font-size: {{font_size.md}};
    font-family: {{font.family}};
    color: {{color.fg_secondary}};
    margin-top: {{space.md}};
}

/* ── Space chips in the taskbar (Super+1…9) ─────────────────────────────── */

.axon-space-strip {
    spacing: {{space.xxs}};
    margin-left: {{space.md}};
}

.axon-space-chip {
    min-width: 28px;
    padding: {{space.xxs}} {{space.sm}};
    border-radius: {{radius.sm}};
    border: 1px solid transparent;
    color: {{color.fg_secondary}};
    font-family: {{font.family}};
    font-size: {{font_size.sm}};
}

.axon-space-chip:hover {
    background-color: {{color.hover}};
}

.axon-space-chip:focus {
    border: {{focus.width}} solid {{color.focus_ring}};
}

/* Active: bold number on a filled pill, not colour alone */
.axon-space-chip-active {
    color: {{color.fg}};
    font-weight: {{font_weight.bold}};
    background-color: {{color.active}};
}

/* Empty: dimmed and no dot */
.axon-space-chip-empty {
    color: {{color.fg_muted}};
}

.axon-space-chip-number {
    font-family: {{font.family}};
}

/* A dot under the number when the Space has windows; a wider bar in the
 * warning colour when one of them wants attention */
.axon-space-chip-dot {
    width: 4px;
    height: 4px;
    margin-top: {{space.xxs}};
    border-radius: {{radius.pill}};
}

.axon-space-chip-dot-windows {
    background-color: {{color.fg_muted}};
}

.axon-space-chip-active .axon-space-chip-dot-windows {
    background-color: {{color.accent_text}};
}

.axon-space-chip-dot-attention {
    width: 12px;
    background-color: {{color.warning}};
}

/* ── Space indicator in the top panel ───────────────────────────────────── */

.axon-space-indicator {
    spacing: {{space.xs}};
}

/* The dot takes the Space's own colour from JS; the label carries the name */
.axon-space-dot {
    font-size: 7.5pt;
}

.axon-space-label {
    color: {{color.fg}};
    font-family: {{font.family}};
    font-size: {{font_size.sm}};
}

/* ── Dock context menu (AI predicted actions) ───────────────────────────── */

.axon-dock-menu {
    background-color: {{color.popup}};
    border: 1px solid {{color.border_strong}};
    border-radius: {{radius.lg}};
    box-shadow: {{shadow}};
    padding: {{space.sm}};
    spacing: {{space.xs}};
}

.axon-dock-menu-item {
    border: {{focus.width}} solid transparent;
    padding: {{space.md}} {{space.xl}};
    border-radius: {{radius.sm}};
    color: {{color.fg}};
    font-size: {{font_size.md}};
    font-weight: {{font_weight.medium}};
    font-family: {{font.family}};
    text-align: left;
    background-color: transparent;
}

/* Loading and error lines among the AI shortcuts: plain text, not a button */
.axon-dock-menu-status {
    color: {{color.fg_muted}};
    font-size: {{font_size.sm}};
    font-weight: {{font_weight.regular}};
}

.axon-dock-menu-item:hover {
    background-color: {{color.hover}};
}

.axon-dock-menu-item:focus {
    background-color: {{color.accent_subtle}};
    border: {{focus.width}} solid {{color.focus_ring}};
}

.axon-dock-menu-title {
    padding: {{space.sm}} {{space.xl}};
    color: {{color.fg_secondary}};
    font-size: {{font_size.sm}};
    font-weight: {{font_weight.semibold}};
    font-family: {{font.family}};
}
