Description: Use the C23 standard only with Meson 1.4 or newer
 Meson 1.3 (Ubuntu 24.04) accepts 'c23' only from 1.4; wlroots checked for 1.3.
Author: Axon OS <axon-os@users.noreply.github.com>
Forwarded: not-needed

--- a/meson.build	2026-10-27 08:53:37.431519292 +0000
+++ b/meson.build	2026-10-27 08:53:37.491743976 +0000
@@ -5,7 +5,7 @@
 	license: 'MIT',
 	meson_version: '>=0.59.0',
 	default_options: [
-		'c_std=' + (meson.version().version_compare('>=1.3.0') ? 'c23,c11' : 'c11'),
+		'c_std=' + (meson.version().version_compare('>=1.4.0') ? 'c23,c11' : 'c11'),
 		'warning_level=2',
 		'werror=true',
 	],
