[Unit]
Description=Axon OS Semantic File Indexer
After=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/python3 AXON_SERVICES_DIR/axon-context/file_indexer.py
Restart=on-failure
RestartSec=10
# Only NoNewPrivileges: PrivateTmp/Protect* need user namespaces in a user
# manager, which Ubuntu 24.04 restricts, so they fail with 218/CAPABILITIES.
NoNewPrivileges=true

[Install]
WantedBy=default.target
