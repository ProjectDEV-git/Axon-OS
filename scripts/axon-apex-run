#!/bin/sh
# axon-apex-run — run a Windows program on Axon OS through APEX-WIN.
#
# Usage: axon-apex-run [--chdir] <program.exe|setup.msi> [args...]
#
#   --chdir  start in the program's own folder (used for double-click, since
#            many Windows programs load data files relative to themselves)
#
# This is the one entry point for Windows programs:
#   * double-click in Files      (axon-apex-win.desktop)
#   * ./program.exe in a terminal (the kernel's binfmt_misc hands any file
#                                  starting with the "MZ" header to this script)
#
# The user picks how programs run in the Welcome app, saved as one word in
# ~/.config/axon-os/windows.conf:
#   apex       (default) APEX-WIN Tier 0: Wine directly, full access to your
#              files, network, GPU and devices, like a native app. No sandbox.
#   sandboxed  APEX-WIN Tier 2: bubblewrap namespaces, isolated home.
#   off        Windows programs don't run.
# Programs always run as you, never as root.
#
# AXON_APEX_TIER=0|1|2|3 overrides the choice for a single launch, e.g.
#   AXON_APEX_TIER=2 axon-apex-run untrusted.exe
# AXON_GAMEMODE=0 skips GameMode; AXON_WINE_DIR=<runner dir> overrides the
# Proton/Wine build chosen with axon-proton-runners (Tier 0 only).
set -eu

RUNNER="${AXON_APEX_RUNNER:-/usr/bin/win-sandbox-runner}"
MODE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/axon-os/windows.conf"

# Tell the user why nothing happened, in the terminal and, for double-click,
# as a desktop notification.
fail() {
    echo "axon-apex-run: $1" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="Axon APEX" --icon=wine "Windows program not started" "$1" \
            2>/dev/null || true
    fi
    exit 1
}

if [ "$#" -lt 1 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "Usage: axon-apex-run [--chdir] <program.exe|setup.msi> [args...]"
    echo "Runs a Windows program with Wine through Axon APEX."
    echo "Choose full access, sandboxed or off in the Welcome app."
    echo "Set AXON_APEX_TIER=0|1|2|3 to override it for one launch."
    [ "$#" -lt 1 ] && exit 1
    exit 0
fi

CHDIR=false
if [ "$1" = "--chdir" ]; then
    CHDIR=true
    shift
    [ "$#" -ge 1 ] || { echo "axon-apex-run: no program given" >&2; exit 1; }
fi

EXE="$1"
shift

if [ ! -f "$EXE" ]; then
    echo "axon-apex-run: file not found: $EXE" >&2
    exit 1
fi

# Wine refuses to run as root, and a Windows program must never get root.
if [ "$(id -u)" -eq 0 ]; then
    echo "axon-apex-run: refusing to run Windows programs as root" >&2
    exit 1
fi

if [ "$CHDIR" = true ]; then
    dir="$(cd "$(dirname "$EXE")" && pwd)"
    EXE="${dir}/$(basename "$EXE")"
    cd "$dir"
fi

MODE=apex
if [ -r "$MODE_FILE" ]; then
    MODE="$(head -n 1 "$MODE_FILE" | tr -d '[:space:]')"
fi

if [ -n "${AXON_APEX_TIER:-}" ]; then
    TIER="$AXON_APEX_TIER"
else
    case "$MODE" in
        sandboxed) TIER=2 ;;
        off)
            fail "Windows programs are turned off. Turn them on in the Welcome app \
(Windows Programs page)."
            ;;
        *) TIER=0 ;;  # apex, or an unreadable/unknown value
    esac
fi

case "$TIER" in
    0|1|2|3) ;;
    *) fail "AXON_APEX_TIER must be 0-3, got '$TIER'" ;;
esac

# .msi packages are not PE files: hand them to Wine's installer service.
# That runs without a sandbox, so only with full access (Tier 0).
case "$EXE" in
    *.msi|*.MSI|*.Msi)
        [ "$TIER" = 0 ] || fail "MSI installers can't run sandboxed. Choose \
'Axon APEX — full access' in the Welcome app to install $(basename "$EXE")."
        exec wine msiexec /i "$EXE" "$@"
        ;;
esac

# Run through GameMode so Axon game mode (AI paused, GPU freed) starts for
# Windows games too. AXON_GAMEMODE=0 turns it off for one launch.
GAMEMODE=""
if [ "${AXON_GAMEMODE:-1}" != 0 ] && command -v gamemoderun >/dev/null 2>&1; then
    GAMEMODE=gamemoderun
fi

if [ -x "$RUNNER" ]; then
    # A Proton/Wine build picked in Game Center (see axon-proton-runners). Only
    # Tier 0 uses it: the sandbox tiers keep the system Wine they were built for.
    if [ "$TIER" = 0 ] && [ -z "${AXON_WINE_DIR:-}" ] \
        && command -v axon-proton-runners >/dev/null 2>&1; then
        AXON_WINE_DIR="$(axon-proton-runners resolve 2>/dev/null || true)"
        [ -z "$AXON_WINE_DIR" ] || export AXON_WINE_DIR
    fi
    # --exe runs APEX-WIN in this process, as this user (never via the root
    # daemon). --no-gui skips the first-launch trust prompt: the tier is fixed.
    # $GAMEMODE is deliberately unquoted: empty means no wrapper.
    # shellcheck disable=SC2086
    exec $GAMEMODE "$RUNNER" --tier "$TIER" --no-gui --exe "$EXE" -- "$@"
fi

# APEX-WIN missing (e.g. a source install without cargo): plain Wine still
# works, but has no sandbox, so never fall back to it for a sandboxed launch.
[ "$TIER" = 0 ] || fail "Axon APEX is not installed, so $(basename "$EXE") can't run sandboxed."
echo "axon-apex-run: $RUNNER not found; running with plain Wine" >&2
exec wine "$EXE" "$@"
