[Unit]
Description=Axon OS Voice (speech-to-intent) Service
After=graphical-session.target dbus.socket
PartOf=graphical-session.target
Requires=dbus.socket

[Service]
Type=dbus
BusName=org.axonos.Voice
ExecStart=/usr/bin/python3 AXON_SERVICES_DIR/axon-voice/voice_service.py
Restart=on-failure
RestartSec=3
# Only NoNewPrivileges: PrivateTmp/Protect* need user namespaces in a user
# manager, which Ubuntu 24.04 restricts, so they fail with 218/CAPABILITIES.
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
